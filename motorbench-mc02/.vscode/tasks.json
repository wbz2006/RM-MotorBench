{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "Build Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug", "--parallel"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "Configure Debug",
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Configure Release",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "Release"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "Build Release",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "Release", "--parallel"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "Configure Release",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash MC02 (DAPLink, Debug)",
            "type": "process",
            "command": "openocd",
            "args": [
                "-f", "${workspaceFolder}/openocd_dap.cfg",
                "-c", "program {build/Debug/Basic_Framework_MC02.elf} verify reset exit"
            ],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "Build Debug",
            "problemMatcher": []
        },
        {
            "label": "Flash MC02 (DAPLink, Release)",
            "type": "process",
            "command": "openocd",
            "args": [
                "-f", "${workspaceFolder}/openocd_dap.cfg",
                "-c", "program {build/Release/Basic_Framework_MC02.elf} verify reset exit"
            ],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "Build Release",
            "problemMatcher": []
        }
    ]
}
