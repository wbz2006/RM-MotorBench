{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "cortex-debug",
            "request": "launch",
            "name": "MotorBench A DAPLink (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/basic_framework_ATYPE.elf",
            "servertype": "openocd",
            "serverpath": "openocd",
            "gdbPath": "arm-none-eabi-gdb",
            "device": "STM32F427IIH6",
            "interface": "swd",
            "configFiles": ["${workspaceFolder}/openocd_dap.cfg"],
            "runToEntryPoint": "main",
            "preLaunchTask": "Build Debug"
        },
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: MotorBench ST-Link",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "deviceName": "STM32F427IIH6",
            "deviceCore": "Cortex-M4",
            "runEntry": "main",
            "serverInterface": "SWD",
            "imagesAndSymbols": [
                {"imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"}
            ]
        },
        {
            "type": "jlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: MotorBench J-Link",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "deviceName": "STM32F427IIH6",
            "deviceCore": "Cortex-M4",
            "serverDevice": "STM32F427II",
            "runEntry": "main",
            "serverInterface": "SWD",
            "imagesAndSymbols": [
                {"imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"}
            ]
        }
    ]
}
