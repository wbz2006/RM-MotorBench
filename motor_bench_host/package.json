{
  "name": "motor-bench-host",
  "version": "1.1.1",
  "description": "大疆 A 板电机测试台 · 上位机(串口桥 + Web UI)",
  "type": "module",
  "private": true,
  "main": "desktop.cjs",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "build:exe": "node node_modules/electron/install.js && electron-builder --config electron-builder.cjs --win portable --x64",
    "test:desktop": "node desktop_test.js",
    "test": "node selftest.js",
    "test:http": "node --test http_test.js",
    "test:guidance": "node guidance_test.cjs",
    "test:integration": "node integration_test.js",
    "test:motor-state": "node motor_state_test.js",
    "test:setpoint": "node --test setpoint_test.js",
    "test:calculator": "node --test calculator_test.js",
    "test:loader": "node loader_test.cjs"
  },
  "dependencies": {
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  }
}
